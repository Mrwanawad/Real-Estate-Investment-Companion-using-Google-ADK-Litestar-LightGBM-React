# Runtime environment label: dev | test | prod
APP_ENV=dev
# SQLAlchemy async URL (Postgres 16 + pgvector; Neon in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reic

# anthropic | gemini | fake (scripted model; default, used by tests)
LLM_PROVIDER=fake
ANTHROPIC_MODEL=claude-sonnet-5-5
# Default Gemini model; override to try another
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# hashing (tests/CI) | minilm (runtime default) | bge-m3 (local eval only)
EMBEDDER=hashing

# Broker handoff: queue API key and the signed (HMAC) webhook
BROKER_API_KEY=
WEBHOOK_URL=
WEBHOOK_SECRET=

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Per-client limit on POST /leads and chat session/message creation (per minute, 0 disables)
RATE_LIMIT_PER_MINUTE=20
# Header a trusted proxy sets to the real client IP; leave empty when not behind one
# CLIENT_IP_HEADER=Fly-Client-IP

# OpenTelemetry export (needs the observability extra)
OTEL_ENABLED=false
# Financing and scenario assumptions (fractions, synthetic defaults shown in outputs)
DISCOUNT_RATE=0.22
MORTGAGE_RATE=0.24
MORTGAGE_YEARS=10
INFLATION_MEAN=0.15
# OTLP collector endpoint used when OTEL_ENABLED=true, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
